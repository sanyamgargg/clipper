<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly pipeline run at 01:30. Template: scripts/install_launchd.sh fills in
     __REPO__ and __LOGS__. If the Mac is asleep at 01:30, launchd runs it on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sanyam.clipper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run_nightly.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>1</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!-- the script logs to __LOGS__/nightly-<date>.log; this only catches startup errors -->
  <key>StandardOutPath</key>
  <string>__LOGS__/launchd-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/launchd-nightly.log</string>
</dict>
</plist>
